{
  "format": 1,
  "id": "lumen-paywall",
  "name": "付费墙清理 · BPC 精简",
  "version": "1.1.1",
  "type": "adblock",
  "description": "从 bypass-paywalls-chrome-clean 提取的付费墙脚本域名与遮挡层选择器。只清理页面元素、拦截付费墙脚本请求，不抓取存档、不改正文；对服务端截断全文的站点无法解锁。",
  "author": "Lumen",
  "license": "MIT",
  "rules": {
    "global": {
      "selectors": [
        "[class*=\"paywall\"]",
        "[id*=\"paywall\"]",
        "[class*=\"Paywall\"]",
        "[data-paywall]",
        "[data-testid*=\"paywall\"]",
        "[data-test-id*=\"paywall\"]",
        ".tp-modal",
        ".tp-backdrop",
        ".tp-container",
        ".tp-iframe-wrapper",
        ".piano-offer",
        ".piano-overlay",
        "#piano-offer",
        ".poool",
        ".poool-widget",
        ".poool-paywall",
        ".regwall",
        ".reg-wall",
        ".meter-wall",
        ".premium-wall",
        ".premium-gate",
        ".content-gate",
        ".article-gate",
        ".paywall-modal",
        ".paywall-overlay",
        ".paywall-container",
        ".paywall-banner",
        "#paywall",
        "#paywall-modal",
        ".subscription-wall",
        ".subscriptionWall"
      ],
      "textPatterns": [],
      "blockHosts": [
        "tinypass.com",
        "cdn.tinypass.com",
        "piano.io",
        "poool.fr",
        "qiota.com",
        "cxense.com",
        "sophi.io",
        "pelcro.com",
        "js.pelcro.com",
        "zephr.com",
        "evolok.net",
        "steadyhq.com",
        "newsmemory.com"
      ]
    },
    "domains": {}
  }
}
